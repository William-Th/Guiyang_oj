@import './theme.wxss';

page {
  background: var(--mp-bg);
  color: var(--mp-text);
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: var(--mp-card-radius);
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 24rpx 12rpx;
  color: var(--mp-text);
}

.page-loading {
  padding: 80rpx 0;
  text-align: center;
  color: var(--mp-text-secondary);
}

/* 自定义 tabBar 悬浮，tab 页底部留白避免内容被遮挡 */
.tab-page-padding {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------- 认证页共用（登录/注册）：品牌区 + 浮动表单卡 ---------- */

.auth-hero {
  background: var(--mp-gradient);
  padding: 120rpx 40rpx 150rpx;
  border-radius: 0 0 56rpx 56rpx;
  text-align: center;
  color: #fff;
}

.auth-mark {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 与 web 端 LoginPage BrandMark 同源：frontend/public/logo.png */
.auth-mark-img {
  width: 80rpx;
  height: 80rpx;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.auth-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.82;
  letter-spacing: 2rpx;
}

.auth-card {
  margin: -84rpx 40rpx 0;
  background: #fff;
  border-radius: var(--mp-card-radius);
  box-shadow: 0 16rpx 48rpx rgba(63, 90, 116, 0.14);
  padding: 40rpx 32rpx 44rpx;
  position: relative;
}

.auth-note {
  font-size: 24rpx;
  color: var(--mp-text-secondary);
  margin-bottom: 20rpx;
}

.auth-tip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--mp-text-secondary);
  line-height: 1.6;
}

.auth-footer {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--mp-text-secondary);
  /* 底部安全区适配：避免被 iPhone 小黑条遮挡 */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.auth-footer .link {
  color: var(--mp-primary);
  font-weight: 600;
}

/* ---------- 骨架屏（全局通用）：模拟卡片结构 + 呼吸动画 ---------- */
.sk-card {
  background: #fff;
  border-radius: var(--mp-card-radius);
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}

.sk-line {
  background: #eef1f5;
  border-radius: 8rpx;
  height: 28rpx;
}

.sk-line-lg {
  height: 40rpx;
  border-radius: 10rpx;
}

.sk-line-sm {
  height: 22rpx;
}

.sk-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eef1f5;
}

.sk-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sk-grow {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sk-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.sk-grid-item {
  height: 120rpx;
  border-radius: 12rpx;
  background: #eef1f5;
}

.sk-hero {
  height: 180rpx;
  border-radius: var(--mp-card-radius);
  background: #eef1f5;
  margin: 0 24rpx 16rpx;
}

@keyframes sk-breath {
  0% { opacity: 1; }
  50% { opacity: 0.45; }
  100% { opacity: 1; }
}

.sk-card, .sk-line, .sk-line-lg, .sk-line-sm, .sk-circle, .sk-grid-item, .sk-hero {
  animation: sk-breath 1.3s ease-in-out infinite;
}
