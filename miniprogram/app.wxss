@import './theme.wxss';

page {
  background: var(--mp-bg);
  color: var(--mp-text);
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: var(--mp-card-radius);
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 24rpx 12rpx;
  color: var(--mp-text);
}

.page-loading {
  padding: 80rpx 0;
  text-align: center;
  color: var(--mp-text-secondary);
}

/* ---------- 认证页共用（登录/注册）：品牌区 + 浮动表单卡 ---------- */

.auth-hero {
  background: var(--mp-gradient);
  padding: 120rpx 40rpx 150rpx;
  border-radius: 0 0 56rpx 56rpx;
  text-align: center;
  color: #fff;
}

.auth-mark {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.auth-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.82;
  letter-spacing: 2rpx;
}

.auth-card {
  margin: -84rpx 40rpx 0;
  background: #fff;
  border-radius: var(--mp-card-radius);
  box-shadow: 0 16rpx 48rpx rgba(63, 90, 116, 0.14);
  padding: 40rpx 32rpx 44rpx;
  position: relative;
}

.auth-note {
  font-size: 24rpx;
  color: var(--mp-text-secondary);
  margin-bottom: 20rpx;
}

.auth-tip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--mp-text-secondary);
  line-height: 1.6;
}

.auth-footer {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--mp-text-secondary);
  /* 底部安全区适配：避免被 iPhone 小黑条遮挡 */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.auth-footer .link {
  color: var(--mp-primary);
  font-weight: 600;
}

