.profile-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--mp-primary);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-role {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.profile-username {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}

.profile-footer {
  margin: 48rpx 24rpx 0;
}

.profile-version {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}
