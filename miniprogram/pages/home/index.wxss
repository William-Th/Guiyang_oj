.home-hero {
  background: var(--mp-gradient);
  padding: 44rpx 32rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-hello {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-status {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-bell {
  position: relative;
  padding: 8rpx;
}

.hero-badge {
  position: absolute;
  top: 0;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f5222d;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-stats {
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.hero-stat {
  flex: 1;
  text-align: center;
}

.hero-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
}

.hero-num {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.home-task {
  display: flex;
  align-items: center;
}

.home-task-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: var(--mp-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.home-task-body {
  flex: 1;
}

.home-task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.home-task-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}

.grid-card {
  padding: 8rpx 0 16rpx;
}

.grid-icon {
  color: var(--mp-primary);
}
