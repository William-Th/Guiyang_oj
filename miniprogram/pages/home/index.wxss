.home-greeting {
  padding: 32rpx 28rpx;
}

.home-hello {
  font-size: 34rpx;
  font-weight: 600;
}

.home-streak-row {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.home-streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--mp-primary);
}

.home-streak-label {
  margin-left: 16rpx;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.home-week {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.home-day {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.home-day.today {
  background: var(--mp-primary);
  color: #fff;
}

.home-task {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.home-task-title {
  font-size: 32rpx;
  font-weight: 600;
}

.home-task-desc {
  margin: 10rpx 0 20rpx;
  font-size: 26rpx;
  color: var(--mp-text-secondary);
}
