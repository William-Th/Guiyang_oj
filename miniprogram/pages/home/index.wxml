<view class="home-page tab-page-padding">
  <view class="home-hero">
    <view class="hero-top">
      <view class="hero-hello-wrap">
        <view class="hero-hello">{{greeting}}，{{realName}}</view>
        <view class="hero-status">{{statusText}}</view>
      </view>
      <view class="hero-bell" bind:tap="onNotice">
        <van-icon name="bell" size="40rpx" color="#ffffff" />
        <view wx:if="{{unread > 0}}" class="hero-badge">{{unread > 99 ? '99+' : unread}}</view>
      </view>
    </view>
    <view class="hero-stats">
      <view class="hero-stat">
        <view class="hero-num">{{streakDays}}</view>
        <view class="hero-label">连胜天数</view>
      </view>
      <view class="hero-divider"></view>
      <view class="hero-stat">
        <view class="hero-num">{{maxStreak}}</view>
        <view class="hero-label">最长连胜</view>
      </view>
      <view class="hero-divider"></view>
      <view class="hero-stat">
        <view class="hero-num">{{points}}</view>
        <view class="hero-label">我的积分</view>
      </view>
    </view>
  </view>

  <view class="section-title">今日任务</view>
  <view class="card home-task" bind:tap="onStartDaily">
    <view class="home-task-icon">
      <van-icon name="star-o" size="40rpx" color="#0ea5e9" />
    </view>
    <view class="home-task-body">
      <view class="home-task-title">每日推题</view>
      <view class="home-task-desc">每天 10 题，答完积分和连胜都到手</view>
    </view>
    <van-icon name="arrow" color="#c8c9cc" />
  </view>
  <view class="card home-task" bind:tap="goPractice">
    <view class="home-task-icon">
      <van-icon name="edit" size="40rpx" color="#0ea5e9" />
    </view>
    <view class="home-task-body">
      <view class="home-task-title">老师发布的练习</view>
      <view class="home-task-desc">按科目和状态筛选，随时开练</view>
    </view>
    <van-icon name="arrow" color="#c8c9cc" />
  </view>

  <view class="section-title">快捷入口</view>
  <view class="card grid-card">
    <van-grid column-num="3" border="{{ false }}">
      <van-grid-item
        wx:for="{{gridItems}}"
        wx:key="text"
        icon="{{item.icon}}"
        text="{{item.text}}"
        icon-class="grid-icon"
        bind:click="onFeature"
      />
    </van-grid>
  </view>
</view>
