.item-icon {
  margin-right: 8rpx;
  color: var(--mp-primary);
  vertical-align: -2rpx;
}

.practice-item-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.practice-item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.practice-item-time {
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}

.reg-cancel-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.registrable-item {
  border: 1rpx solid #fef3c7;
}

.reg-actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.section-title {
  padding: 20rpx 28rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mp-text-secondary);
}

.item-locked {
  opacity: 0.62;
}
