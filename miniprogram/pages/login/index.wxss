.login-btn {
  margin-top: 44rpx;
}

.wx-divider {
  margin: 32rpx 0 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--mp-text-secondary);
  font-size: 24rpx;
}

.wx-divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--mp-border);
}

.wx-btn {
  color: var(--mp-primary);
  border-color: var(--mp-primary);
  font-weight: 600;
}

.footer-divider {
  margin: 0 16rpx;
  color: #d1d5db;
}
