.notif-page {
  padding-top: 20rpx;
}

/* ---------- tab / 筛选（复用审批中心视觉） ---------- */
.seg-bar {
  display: flex;
  padding: 0 24rpx 8rpx;
  gap: 16rpx;
}

.seg-item {
  position: relative;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.seg-item.active {
  background: var(--mp-primary);
  color: #fff;
  font-weight: 600;
}

.seg-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 700;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 24rpx;
}

.filter-bar {
  display: flex;
  padding: 12rpx 24rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.filter-item.active {
  background: var(--mp-primary);
  color: #fff;
}

.mark-all {
  font-size: 24rpx;
  color: var(--mp-primary);
  padding: 8rpx 0;
}

.mark-all.disabled {
  opacity: 0.5;
}

/* ---------- 通知/公告卡 ---------- */
.notif-item {
  position: relative;
}

.notif-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.notif-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mp-text-primary, #1f2937);
}

.notif-title.read {
  font-weight: 400;
  color: var(--mp-text-secondary);
}

.notif-type {
  flex-shrink: 0;
}

.notif-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--mp-text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.notif-content.expanded {
  display: block;
  color: var(--mp-text-primary, #374151);
}

.notif-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
