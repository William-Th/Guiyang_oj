.submit-btn {
  margin-top: 40rpx;
}

.reg-result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mp-success);
  margin-bottom: 16rpx;
}

.reg-result-row {
  font-size: 27rpx;
  color: var(--mp-text);
  margin-bottom: 10rpx;
}




.status-card {
  margin-top: 36rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--mp-bg);
}

.status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 600;
}

.status-row {
  font-size: 25rpx;
  color: var(--mp-text-secondary);
  margin-top: 8rpx;
  line-height: 1.6;
}
