.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #f1f2f4;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  color: #6b7280;
}

.tab-item.active {
  color: #0ea5e9;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.tab-item.active .tab-text {
  font-weight: 600;
}
