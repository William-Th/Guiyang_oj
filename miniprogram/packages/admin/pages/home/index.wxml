<view class="admin-hero">
  <view class="admin-hero-title">管理工作台</view>
  <view class="admin-hero-me" bind:tap="goProfile">
    <van-icon name="user-o" size="36rpx" />
    <text>我的</text>
  </view>
</view>

<block wx:if="{{!loading}}">
  <view class="card stat-grid">
    <view class="stat-cell">
      <view class="stat-num">{{stats.totalStudents}}</view>
      <view class="stat-label"><van-icon name="friends-o" /> 学生总数</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.totalExams}}</view>
      <view class="stat-label"><van-icon name="todo-list-o" /> 测评总数</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.thisMonthExams}}</view>
      <view class="stat-label"><van-icon name="calendar-o" /> 本月测评</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.onlineTeachers}}</view>
      <view class="stat-label"><van-icon name="manager-o" /> 活跃教师</view>
    </view>
  </view>

  <van-cell-group inset title="待办">
    <van-cell title="审批中心" icon="todo-list-o" is-link bind:click="goApprovals" label="{{pendingCount > 0 ? '注册申请与教学班待审 ' + pendingCount + ' 项' : '暂无待办'}}">
      <van-tag wx:if="{{pendingCount > 0}}" type="danger">待办 {{pendingCount}}</van-tag>
    </van-cell>
    <van-cell title="用户查询" label="学生/教师信息检索" icon="search" is-link bind:click="goUsers" />
  </van-cell-group>

  <view class="section-title">最近测评</view>
  <view wx:for="{{stats.recentExams}}" wx:key="id" class="card exam-item">
    <view class="exam-item-name">{{item.name}}</view>
    <view class="exam-item-meta">
      <text>{{item.date}}</text>
      <text>{{item.participants}} 人参与 · 均分 {{item.avgScore}}</text>
    </view>
  </view>
  <van-empty wx:if="{{stats.recentExams.length === 0}}" description="暂无测评数据" />
</block>
<view wx:else class="page-loading">加载中…</view>
