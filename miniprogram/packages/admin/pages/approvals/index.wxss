.filter-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.filter-item.active {
  background: var(--mp-primary);
  color: #fff;
}

.approval-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.approval-item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.approval-item-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}

.approval-item-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
