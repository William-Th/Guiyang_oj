.user-search {
  padding: 20rpx 24rpx 0;
  background: #fff;
}

.user-tabs {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  background: #fff;
}

.user-tab {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.user-tab.active {
  background: var(--mp-primary);
  color: #fff;
}

.user-item {
  padding: 24rpx;
}

.user-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
}

.user-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}
