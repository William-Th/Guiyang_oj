.answer-page {
  padding-bottom: 200rpx;
}

.answer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.answer-title {
  font-size: 30rpx;
  font-weight: 600;
}

.answer-progress {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mp-text-secondary);
}

.answer-countdown {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--mp-primary-bg);
  color: var(--mp-primary-dark);
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.answer-countdown.danger {
  background: #fff1f0;
  color: var(--mp-danger);
}

.question-card {
  margin-top: 20rpx;
}

.question-tag-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.question-content {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--mp-text);
  word-break: break-all;
}

.question-image {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
}

.options {
  margin-top: 24rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border: 2rpx solid var(--mp-border);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}

.option.selected {
  border-color: var(--mp-primary);
  background: var(--mp-primary-bg);
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option.selected .option-letter {
  background: var(--mp-primary);
  color: #fff;
}

.option-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.type-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}

.tf-row {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.tf-btn {
  flex: 1;
  height: 110rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--mp-border);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mp-text-secondary);
}

.tf-btn.selected {
  border-color: var(--mp-primary);
  background: var(--mp-primary-bg);
  color: var(--mp-primary-dark);
}

.blank-wrap {
  margin-top: 32rpx;
}

.blank-input {
  height: 92rpx;
  border: 2rpx solid var(--mp-border);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.area-wrap {
  margin-top: 32rpx;
}

.essay-area {
  width: 100%;
  height: 260rpx;
  border: 2rpx solid var(--mp-border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-card {
  margin-top: 32rpx;
  border: 2rpx dashed var(--mp-warning);
  border-radius: 16rpx;
  padding: 24rpx;
  background: #fffbeb;
}

.code-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #b45309;
  font-weight: 600;
}

.code-template {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #1f2937;
  color: #e5e7eb;
  border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 400rpx;
  overflow: hidden;
}

.answer-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-top: 1rpx solid #f1f2f4;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 50;
}

.answer-sheet-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--mp-primary);
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.sheet {
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.sheet-scroll {
  max-height: 45vh;
}

.sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.sheet-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-item.answered {
  background: var(--mp-primary-bg);
  color: var(--mp-primary-dark);
  font-weight: 600;
}

.sheet-item.current {
  background: var(--mp-primary);
  color: #fff;
}

.sheet-submit {
  margin-top: 8rpx;
}
