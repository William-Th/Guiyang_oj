.code-page {
  padding: 20rpx 0 60rpx;
}

.section {
  padding: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mp-text-primary, #1f2937);
}

.limits {
  display: flex;
  gap: 10rpx;
}

.limit-tag {
  font-size: 20rpx;
  color: var(--mp-text-secondary);
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.q-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--mp-text-primary, #1f2937);
  word-break: break-all;
}

/* ---------- 样例 ---------- */
.samples {
  margin-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 16rpx;
}

.sample-case {
  margin-bottom: 14rpx;
}

.sample-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mp-text-secondary);
  margin-bottom: 8rpx;
}

.sample-io {
  display: flex;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.io-key {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--mp-primary);
  background: #f0f9ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  height: fit-content;
}

.io-val {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #374151;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- 编辑器 ---------- */
.lang-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.lang-text {
  font-size: 24rpx;
  font-weight: 600;
  font-family: Menlo, Consolas, monospace;
  color: var(--mp-text-primary, #1f2937);
}

.key-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.key {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 10rpx;
  background: #f3f4f6;
  color: #374151;
}

.key-ghost {
  margin-left: auto;
  color: var(--mp-primary);
  background: #f0f9ff;
}

.key-hover {
  background: #e5e7eb;
}

.code-area {
  width: 100%;
  min-height: 480rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #0f172a;
  color: #e2e8f0;
  font-family: Menlo, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ---------- 判题结果 ---------- */
.judge-card {
  margin-top: 16rpx;
}

.judge-running {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.judge-text {
  font-size: 26rpx;
  color: var(--mp-text-secondary);
}

.result-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.result-score {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mp-primary-dark);
}

.result-time {
  font-size: 24rpx;
  color: var(--mp-text-secondary);
  margin-left: auto;
}

.compile-out {
  margin-top: 16rpx;
  background: #0f172a;
  border-radius: 10rpx;
  padding: 16rpx;
}

.compile-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.compile-text {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #e2e8f0;
  white-space: pre-wrap;
  word-break: break-all;
}

.cases {
  margin-top: 16rpx;
}

.case-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.case-row.pass {
  background: #f0fdf4;
  color: #16a34a;
}

.case-row.fail {
  background: #fef2f2;
  color: #dc2626;
}

.case-name {
  flex: 1;
}

.case-time {
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}

.result-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.submit-wrap {
  padding: 24rpx;
}
