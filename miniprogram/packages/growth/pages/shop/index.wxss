.shop-hero {
  background: var(--mp-gradient);
  color: #fff;
  text-align: center;
  padding: 48rpx 0 44rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.shop-hero-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1;
}

.shop-hero-label {
  margin-top: 12rpx;
  font-size: 25rpx;
  opacity: 0.85;
}

.filter-bar {
  display: flex;
  padding: 20rpx 24rpx 0;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.filter-item.active {
  background: var(--mp-primary);
  color: #fff;
}

.shop-item {
  display: flex;
  align-items: center;
}

.shop-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--mp-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.shop-item-color-check {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.shop-item-body {
  flex: 1;
  min-width: 0;
}

.shop-item-name {
  font-size: 29rpx;
  font-weight: 600;
}

.shop-item-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}

.shop-item-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: 16rpx;
}

.shop-item-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--mp-warning);
}
