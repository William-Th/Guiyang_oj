<view class="rank-hero">
  <view class="rank-hero-title">积分排行榜</view>
  <view class="rank-hero-sub" wx:if="{{myEntry}}">我的排名：第 {{myEntry.rank}} 名 · {{myEntry.points}} 分</view>
</view>

<view class="filter-bar">
  <view
    wx:for="{{filters}}"
    wx:key="value"
    class="filter-item {{type === item.value ? 'active' : ''}}"
    data-type="{{item.value}}"
    bind:tap="onTypeChange"
  >
    {{item.label}}
  </view>
</view>

<block wx:if="{{!loading}}">
  <view
    wx:for="{{list}}"
    wx:key="student_id"
    class="card rank-item {{item.isMe ? 'me' : ''}}"
  >
    <view class="rank-num r{{item.rank <= 3 ? item.rank : 'rest'}}">{{item.rank}}</view>
    <view class="rank-body">
      <view class="rank-name">
        {{item.student_name}}
        <text wx:if="{{item.isMe}}" class="rank-me-tag">我</text>
      </view>
      <view class="rank-meta">{{item.schoolName}}{{item.className ? ' · ' + item.className : ''}}</view>
    </view>
    <view class="rank-points">{{item.points}} 分</view>
  </view>
  <van-empty wx:if="{{list.length === 0}}" description="暂无排行数据" />
</block>
<view wx:if="{{loading}}" class="page-loading">加载中…</view>
