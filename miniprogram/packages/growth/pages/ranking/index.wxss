.rank-hero {
  background: var(--mp-gradient);
  color: #fff;
  padding: 40rpx 40rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.rank-hero-title {
  font-size: 36rpx;
  font-weight: 700;
}

.rank-hero-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  opacity: 0.85;
}

.filter-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  font-size: 26rpx;
}

.filter-item.active {
  background: var(--mp-primary);
  color: #fff;
}

.rank-item {
  display: flex;
  align-items: center;
}

.rank-item.me {
  border: 2rpx solid var(--mp-primary);
  background: var(--mp-primary-bg);
}

.rank-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  background: #f3f4f6;
  color: var(--mp-text-secondary);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.rank-num.r1 {
  background: #fff7d6;
  color: #d48806;
}

.rank-num.r2 {
  background: #f0f0f0;
  color: #616161;
}

.rank-num.r3 {
  background: #fff1e0;
  color: #c2660a;
}

.rank-body {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 29rpx;
  font-weight: 600;
}

.rank-me-tag {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--mp-primary);
  border: 2rpx solid var(--mp-primary);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.rank-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--mp-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-points {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mp-primary-dark);
  margin-left: 16rpx;
}
