<view class="wq-stats card">
  <view class="wq-stat">
    <view class="wq-stat-num">{{stats.total}}</view>
    <view class="wq-stat-label"><van-icon name="bookmark-o" /> 累计错题</view>
  </view>
  <view class="wq-stat">
    <view class="wq-stat-num warn">{{stats.byStatus.active}}</view>
    <view class="wq-stat-label"><van-icon name="warning-o" /> 待攻克</view>
  </view>
  <view class="wq-stat">
    <view class="wq-stat-num ok">{{stats.byStatus.mastered}}</view>
    <view class="wq-stat-label"><van-icon name="passed" /> 已掌握</view>
  </view>
</view>

<block wx:if="{{!loading}}">
  <view wx:for="{{list}}" wx:key="id" class="card wq-item">
    <!-- 行1：科目/题型/难度 + 状态 -->
    <view class="wq-head">
      <view class="wq-head-tags">
        <van-tag plain type="primary" wx:if="{{item.subject}}">{{item.subject}}</van-tag>
        <van-tag plain>{{item.typeText}}</van-tag>
        <van-tag plain wx:if="{{item.difficultyText}}">{{item.difficultyText}}</van-tag>
      </view>
      <van-tag type="{{item.statusTag}}">{{item.statusText}}</van-tag>
    </view>

    <!-- 行2：题干（两行截断） -->
    <rich-text class="wq-content" nodes="{{item.contentHtml}}" />

    <!-- 行3：知识点 -->
    <view class="wq-kps" wx:if="{{item.kpTags.length > 0}}">
      <van-tag plain wx:for="{{item.kpTags}}" wx:for-item="kp" wx:key="*this">{{kp}}</van-tag>
    </view>

    <!-- 行4：元信息 + 重练 -->
    <view class="wq-foot">
      <view class="wq-meta">
        <text wx:if="{{item.error_count}}" class="wq-error">错 {{item.error_count}} 次</text>
        <text wx:if="{{item.lastWrongText}}">最近 {{item.lastWrongText}}</text>
        <text wx:if="{{item.needsPc}}" class="wq-pc-hint">该题型请在电脑端重练</text>
      </view>
      <van-button wx:if="{{item.canRedo}}" size="small" round type="primary" bind:click="onRedo" data-id="{{item.id}}">
        重练这题
      </van-button>
    </view>
  </view>
  <van-empty wx:if="{{list.length === 0}}" description="太棒了，暂时没有待攻克的错题" />
</block>
<view wx:if="{{loading}}" class="page-loading">加载中…</view>
