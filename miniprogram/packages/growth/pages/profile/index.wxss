.profile-hero {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.hero-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 170rpx;
}

.hero-label {
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}

.hero-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--mp-primary-dark);
  line-height: 1.1;
}

.hero-unit {
  font-size: 28rpx;
  font-weight: 600;
}

.hero-stats {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border-left: 1rpx solid #f1f5f9;
  padding-left: 30rpx;
}

.stat-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mp-text-primary, #1f2937);
  min-width: 90rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--mp-text-secondary);
}

.daily-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.daily-text {
  font-size: 24rpx;
  color: var(--mp-text-secondary);
  line-height: 1.6;
}

/* ---------- 薄弱知识点 ---------- */
.weak-item {
  margin-bottom: 24rpx;
}

.weak-item:last-of-type {
  margin-bottom: 8rpx;
}

.weak-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.weak-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--mp-text-primary, #1f2937);
}

.weak-rate {
  font-size: 28rpx;
  font-weight: 700;
}

.weak-bar {
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
}

.weak-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.weak-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.weak-tip {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.chart-card {
  padding: 24rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--mp-text-primary, #1f2937);
  margin-bottom: 12rpx;
}

.chart-box {
  height: 480rpx;
}

.trend-box {
  height: 400rpx;
}
