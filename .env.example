# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.
POSTGRES_DB=guiyang_oj
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-random-value
SESSION_SECRET=replace-with-another-independent-random-value

PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-random-password
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:8080
